# Copie ce fichier en .env (jamais commité). Lu par les scripts et le serveur, PAS par le front.

# Clé du wallet admin : déploie le contrat, lance les rounds, distribue les MON aux joueurs.
# Crée-la avec `cast wallet new`, puis envoie-lui tes MON de testnet (faucet).
ADMIN_PRIVATE_KEY=0x...

# Optionnel : endpoint RPC dédié (Alchemy / QuickNode gratuit) utilisé par le serveur et les scripts.
# RPC_URL=https://...
# RPC_WS=wss://...

# Serveur
PORT=8787
ROOM_CODE=AURA            # code affiché sur l'écran géant, exigé pour recevoir des MON
ADMIN_TOKEN=change-moi    # protège /admin/start et /admin/stop (URL de l'écran : /screen?room=AURA&token=...)
FLUSH_MS=300              # 300 = 1 tx par bloc et par joueur ; 600 = deux fois moins cher

# Budget MON (le vrai garde-fou) : un joueur ne peut pas coûter plus que DRIP_MON × DRIP_MAX_PER_ADDRESS.
DRIP_MON=0.15
DRIP_MAX_PER_ADDRESS=4
DRIP_BUDGET_MON=30        # MON versés dans le contrat AuraDrip au déploiement (plafonné au solde) et plafond par session du serveur
