# Variables VITE_* = PUBLIQUES (incluses dans le JS envoyé aux téléphones). Jamais de clé privée ici.
# En local, `pnpm demo` force VITE_NETWORK=local : ce fichier ne sert que pour le déploiement (Vercel).
VITE_NETWORK=testnet
# URL publique du serveur (https). Non définie → http://<hôte de la page>:8787, pratique en local.
# VITE_SERVER_URL=https://mon-serveur.example.com
